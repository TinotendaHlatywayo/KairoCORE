name: KairoCORE Production Deployment

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: kairocore-production
  cancel-in-progress: false

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Build production Docker image
        env:
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          docker build --pull \
            -t "kairocore-app:${IMAGE_TAG}" \
            -t kairocore-app:latest .

      - name: Export Docker image
        env:
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          docker save \
            "kairocore-app:${IMAGE_TAG}" \
            kairocore-app:latest \
            | gzip -1 > "kairocore-${IMAGE_TAG}.tar.gz"

      - name: Configure SSH
        env:
          SSH_PRIVATE_KEY: ${{ secrets.VPS_SSH_PRIVATE_KEY }}
          SSH_KNOWN_HOSTS: ${{ secrets.VPS_KNOWN_HOSTS }}
        shell: bash
        run: |
          set -euo pipefail
          install -m 700 -d ~/.ssh
          printf '%s\n' "$SSH_PRIVATE_KEY" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          printf '%s\n' "$SSH_KNOWN_HOSTS" > ~/.ssh/known_hosts
          chmod 600 ~/.ssh/known_hosts
          ssh-keygen -y -f ~/.ssh/deploy_key > /dev/null

      - name: Transfer image to VPS
        env:
          VPS_HOST: ${{ secrets.VPS_HOST }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          ssh -i ~/.ssh/deploy_key \
            -o BatchMode=yes \
            "kuberdeploy@${VPS_HOST}" \
            'mkdir -p /opt/kuber/clients/KairoCORE/deploy/incoming'

          scp -i ~/.ssh/deploy_key \
            -o BatchMode=yes \
            "kairocore-${IMAGE_TAG}.tar.gz" \
            "kuberdeploy@${VPS_HOST}:/opt/kuber/clients/KairoCORE/deploy/incoming/"

      - name: Deploy and verify
        env:
          VPS_HOST: ${{ secrets.VPS_HOST }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          ssh -i ~/.ssh/deploy_key \
            -o BatchMode=yes \
            "kuberdeploy@${VPS_HOST}" \
            "bash /opt/kuber/clients/KairoCORE/deploy/deploy.sh '${IMAGE_TAG}'"

      - name: Clean up SSH credentials
        if: always()
        run: rm -f ~/.ssh/deploy_key
