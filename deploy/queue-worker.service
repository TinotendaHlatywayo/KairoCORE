[Unit]
Description=Kairo CORE Queue Worker
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/kairocore
ExecStart=/usr/bin/php /var/www/kairocore/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
