services:

  # ============================================================
  # Laravel Application
  # PHP 8.3 + Apache
  # ============================================================
  app:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: schoolcore-app

    restart: unless-stopped

    environment:
      APP_NAME: ${APP_NAME}
      APP_ENV: ${APP_ENV:-production}
      APP_DEBUG: ${APP_DEBUG:-false}
      APP_URL: ${APP_URL}

      LOG_CHANNEL: ${LOG_CHANNEL:-stderr}
      LOG_LEVEL: ${LOG_LEVEL:-warning}

      DB_CONNECTION: mysql
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: ${DB_DATABASE}
      DB_USERNAME: ${DB_USERNAME}
      DB_PASSWORD: ${DB_PASSWORD}

    depends_on:
      db:
        condition: service_healthy

    volumes:
      - laravel_storage:/var/www/html/storage

    networks:
      - client_internal
      - kuber-proxy

    # Resource protection
    mem_limit: 1g
    cpus: "1.0"
    pids_limit: 200

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "curl -f http://localhost/up || exit 1"
        ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s


  # ============================================================
  # MySQL Database
  # ============================================================
  db:
    image: mysql:8.0

    container_name: schoolcore-db

    restart: unless-stopped

    environment:
      MYSQL_DATABASE: ${DB_DATABASE}

      MYSQL_USER: ${DB_USERNAME}

      MYSQL_PASSWORD: ${DB_PASSWORD}

      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}

    volumes:
      - dbdata:/var/lib/mysql

    networks:
      - client_internal

    # Database resource protection
    mem_limit: 1.5g
    cpus: "1.0"
    pids_limit: 200

    healthcheck:
      test:
        [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "localhost",
          "-u${DB_USERNAME}",
          "-p${DB_PASSWORD}"
        ]

      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s


# ============================================================
# Persistent Storage
# ============================================================

volumes:

  dbdata:
    driver: local

  laravel_storage:
    driver: local


# ============================================================
# Networks
# ============================================================

networks:

  # Private client network
  client_internal:
    driver: bridge

  # Existing Kuber reverse proxy network
  kuber-proxy:
    external: true
